# /etc/edu19-backup.env —— backup_daily.sh 的配置（装完请 chmod 600 / chown root:root）
# 优先级：脚本默认值 < 本文件 < 命令行参数

PROJECT_DIR=/opt/edu-app
STAGE_DIR=/opt/edu-app/backup
DB_CONTAINER=edu19-prod-db-1
WEB_CONTAINER=edu19-prod-web-1
DB_NAME=edu19
DB_USER=odoo

# 保留策略：最近 KEEP 份 + 每月 1 份保留 KEEP_MONTHLY 个月
KEEP=7
KEEP_MONTHLY=12

# 每份备份都必须在生产机本机还原彩排一次（默认开，别关）
REHEARSE=1

# ── 异地目标（三选一）──────────────────────────────────────────────
# none   = 只落本机 => 判定 INCOMPLETE，退出码 3（等于没备份，不要用）
# rsync  = 推到另一台机器（推荐：另一家 VPS / NAS / 办公机；需要免密 SSH）
# rclone = 推到对象存储（需 apt-get install rclone && rclone config）
OFFSITE_KIND=rsync
OFFSITE_TARGET=backup@offsite-host:/srv/edu19-backup/
# 专用密钥（可选）
#OFFSITE_SSH_KEY=/root/.ssh/edu19_backup_ed25519

# OFFSITE_KIND=rclone
# RCLONE_REMOTE=myremote:edu19-backup
