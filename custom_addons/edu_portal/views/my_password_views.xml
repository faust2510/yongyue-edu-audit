<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ /my/password 自助修改密码 ============ -->
    <template id="edu_my_password" name="Edu My Password">
        <t t-call="edu_portal.edu_page">
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8">
                    <h4 class="mb-1"><i class="fa fa-lock me-2"/>修改密码</h4>
                    <p class="text-muted">为保障账号安全，请定期更换密码（至少 8 位）。</p>

                    <div t-if="ok" class="alert alert-success" role="alert">
                        <i class="fa fa-check-circle me-1"/>密码修改成功，下次登录请使用新密码。
                    </div>
                    <div t-if="error" class="alert alert-danger" role="alert">
                        <i class="fa fa-exclamation-circle me-1"/><t t-out="error"/>
                    </div>

                    <form action="/my/password/save" method="post"
                          class="card shadow-sm border-0 rounded-3 mt-3">
                        <div class="card-body p-4">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <div class="mb-3">
                                <label class="form-label" for="old_password">当前密码</label>
                                <input type="password" name="old_password"
                                       id="old_password" required="required"
                                       autocomplete="current-password"
                                       placeholder="请输入当前密码" class="form-control"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="new_password">新密码</label>
                                <input type="password" name="new_password"
                                       id="new_password" required="required"
                                       minlength="8" autocomplete="new-password"
                                       placeholder="至少 8 位" class="form-control"/>
                            </div>
                            <div class="mb-4">
                                <label class="form-label" for="confirm_password">确认新密码</label>
                                <input type="password" name="confirm_password"
                                       id="confirm_password" required="required"
                                       minlength="8" autocomplete="new-password"
                                       placeholder="再次输入新密码" class="form-control"/>
                            </div>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fa fa-save me-1"/>保存新密码
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>
