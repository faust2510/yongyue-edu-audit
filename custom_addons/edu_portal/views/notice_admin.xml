        <field name="model_id" ref="model_edu_approval_delegate"/>
        <field name="group_id" ref="openeducat_core.group_op_faculty"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
