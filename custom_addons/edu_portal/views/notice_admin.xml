        <field name="group_id" ref="base.group_system"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="access_edu_subject_prereq_admin" model="ir.model.access">
        <field name="name">edu.subject.prereq 教务处/管理员</field>
        <field name="model_id" ref="model_edu_subject_prereq"/>
        <field name="group_id" ref="openeducat_core.group_op_back_office_admin"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="access_edu_subject_prereq_system" model="ir.model.access">
        <field name="name">edu.subject.prereq 系统管理员</field>
        <field name="model_id" ref="model_edu_subject_prereq"/>
        <field name="group_id" ref="base.group_system"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
