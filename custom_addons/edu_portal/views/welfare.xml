    <template id="edu_welfare_board" name="Edu Welfare Checkin Board">
        <t t-call="edu_portal.edu_page">
            <h4 class="mb-1 d-flex align-items-center gap-2 flex-wrap">
                <span><i class="fa fa-table me-2"/>打卡看板</span>
                <a class="btn btn-sm btn-outline-secondary ms-auto" href="/my/checkins">
                    <i class="fa fa-arrow-left me-1"/>返回我的打卡</a>
            </h4>
            <p class="text-muted mb-3">
                本周（周一至周日）全体学生的到堂打卡一览。打勾为当日已打卡，
                「—」为未打卡，「·」为尚未到来的日期。
            </p>

            <t t-if="missing">
                <div class="alert alert-warning py-2">
                    <i class="fa fa-bell me-1"/>今日尚未打卡：
                    <t t-foreach="missing" t-as="m">
                        <span t-out="m.name"/><t t-if="not m_last">、</t>
                    </t>
                </div>
            </t>
            <t t-else="">
                <div class="alert alert-success py-2">
                    <i class="fa fa-check-circle me-1"/>今日全员已打卡。</div>
            </t>

            <!-- 窄屏卡片化（task-15，2026-10-02）：本表 8 列（学生 + 7 天）在 375 视口「装得下」
                 （345 = 容器宽），判据 A 看不见；但 7 个表头被压成上下两行（周几 + 日期两行是设计，
                 压窄后更难读，工具判据 C：折行表头×7）。
                 复用共用模板 edu_portal.edu_narrow_table_cards：<768px 隐藏 thead、每行折成卡片。
                 动态列（7 天）的列名用 cell 自带的日期算出来：周几用字面量元组按 weekday() 取，
                 日期用 strftime —— 都不依赖控制器多传参数（控制器不在本卡写作用域）。 -->
            <t t-call="edu_portal.edu_narrow_table_cards"/>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle edu-card-table">
                    <thead class="table-light">
                        <tr>
                            <th>学生</th>
                            <th t-foreach="days" t-as="day" class="text-center">
                                <span t-out="day[1]"/><br/>
                                <small class="text-muted" t-out="day[0]"/></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="rows" t-as="row">
                            <td data-label="学生"><span t-out="row['student'].name"/></td>
                            <td t-foreach="row['cells']" t-as="cell" class="text-center"
                                t-att-data-label="['周一','周二','周三','周四','周五','周六','周日'][cell['d'].weekday()] + ' ' + cell['d'].strftime('%m-%d')">
                                <t t-if="cell['done']"><i class="fa fa-check text-success"/></t>
                                <t t-elif="cell['future']"><span class="text-muted">·</span></t>
                                <t t-else=""><span class="text-danger">—</span></t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
