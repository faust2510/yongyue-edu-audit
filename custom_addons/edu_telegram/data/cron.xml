<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_telegram_daily_push" model="ir.cron">
        <field name="name">edu_telegram: 每日推送(待缴/作业截止/考试临近)</field>
        <field name="model_id" ref="model_edu_telegram_push"/>
        <field name="state">code</field>
        <field name="code">model.cron_daily()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_telegram_notice_push" model="ir.cron">
        <field name="name">edu_telegram: 公告推送(每小时)</field>
        <field name="model_id" ref="model_op_notice"/>
        <field name="state">code</field>
        <field name="code">model.push_new()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
