<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ /quiz 测验列表（学生） ============ -->
    <template id="edu_quiz_portal_list" name="Edu Quiz Portal List">
        <!-- 门户壳（edu_portal.edu_page）**已提供** #wrap.o_portal_wrap
             （edu_portal_templates.xml:18）与 container.b11-content（:236），
             故这里**不再自套**这两层：本仓成文标准 = 门户页外壳 t-call="edu_portal.edu_page"
             （docs/code-map.md:93/§4、dev-workflow.md:157）；同类修复见 edu_life
             （commit f8eff9d）。实测后果（375，改前）：公开站页头可见、顶栏无搜索框、
             已登录仍显示「登录」链接、底部 Tab=0。 -->
        <t t-call="edu_portal.edu_page">
            <div class="oe-cat-head">
                <span class="oe-cat-dot"></span>
                <h2 class="oe-cat-title">在线测验</h2>
                <span class="oe-cat-count" t-out="str(len(items)) + ' items'"/>
            </div>
            <form method="get" action="/quiz" class="row g-2 align-items-end mb-3 mt-1">
                <div class="col-auto flex-grow-1">
                    <input type="search" class="form-control" name="search"
                           placeholder="搜索测验名称或分类" t-out="search or ''"/>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" type="submit">搜索</button>
                </div>
                <div class="col-auto ms-auto">
                    <a href="/quiz/my" class="btn btn-outline-secondary">
                        <i class="fa fa-line-chart me-1"/>我的成绩</a>
                </div>
            </form>
            <t t-if="not items">
                <div class="oe-norec mt-3">
                    <i class="fa fa-question-circle oe-norec-ic" aria-hidden="true"></i>
                    <p class="oe-norec-txt">暂无已发布的测验。</p>
                </div>
            </t>
            <div t-else="" class="o_portal_docs row g-2 mt-2">
                <t t-foreach="items" t-as="it">
                    <div class="o_portal_index_card col-md-6 position-relative">
                        <a t-att-href="'/quiz/' + str(it['quiz'].id) + '/take'"
                           class="d-flex justify-content-start gap-2 gap-md-3 align-items-center py-3 pe-2 px-md-3 h-100 rounded text-decoration-none text-reset text-bg-light position-relative">
                            <div class="o_portal_icon d-block align-self-start">
                                <i class="fa fa-pencil-square-o fa-lg text-primary" aria-hidden="true"></i>
                            </div>
                            <div>
                                <div class="mt-0 mb-1 fs-5 fw-normal lh-1"><span t-out="it['quiz'].name"/></div>
                                <div class="opacity-75">
                                    <t t-if="it['quiz'].category" t-out="it['quiz'].category"/>
                                    · 题目 <t t-out="len(it['quiz'].question_ids)"/>
                                    · 总分 <t t-out="it['quiz'].total_points"/>
                                </div>
                            </div>
                        </a>
                        <!-- B6: 已尝试过则徽章链接到最近一次结果页（独立 a，避免嵌套锚点） -->
                        <a t-if="it['tried']"
                           t-att-href="'/quiz/' + str(it['quiz'].id) + '/result/' + str(it['best_attempt_id'])"
                           t-att-class="'oe_count badge rounded-pill ' + ('text-bg-success' if it['best_pct'] >= 60 else 'text-bg-secondary')"
                           style="position:absolute;top:12px;right:12px;text-decoration:none;"
                           aria-label="查看最近一次测验结果">
                            <t t-out="'最好 ' + str(it['best_pct']) + '%'"/>
                        </a>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- ============ /quiz/&lt;id&gt;/take 作答页 ============ -->
    <template id="edu_quiz_take" name="Edu Quiz Take">
        <!-- 换回门户壳（#wrap.o_portal_wrap 与 container 由 edu_page 提供，不再自套）。
             ⚠ 答题页限宽 **必须保留**：原来挂在自套的 container 上（style="max-width: 900px"），
             改后挪到内容最外层的这个内层 div（mx-auto 保持居中）—— 不多不少一层。
             1440 实测：改前 container max-width=900px/width=900；改后本 div 同读数。
             答题表单的字段名/action/提交按钮一字未动（作答与判分逻辑不受换壳影响）。 -->
        <t t-call="edu_portal.edu_page">
            <div class="mx-auto" style="max-width: 900px;">
                <div class="oe-cat-head mb-2">
                    <span class="oe-cat-dot"></span>
                    <h2 class="oe-cat-title" t-out="quiz.name"/>
                    <span class="oe-cat-count">
                        限时 <t t-out="quiz.duration"/> 分钟 · 共
                        <t t-out="len(quiz.question_ids)"/> 题 · 总分
                        <t t-out="quiz.total_points"/>
                    </span>
                </div>
                <form method="post" t-attf-action="/quiz/{{ quiz.id }}/submit">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="quiz_id" t-att-value="quiz.id"/>
                    <t t-foreach="quiz.question_ids" t-as="q">
                        <div class="card my-3 shadow-sm border-0 rounded-3">
                            <div class="card-body">
                                <h5 class="card-title mb-3">
                                    第<t t-out="q_index + 1"/>题
                                    <span class="badge text-bg-light ms-2"><t t-out="q.points"/> 分</span>
                                </h5>
                                <p class="card-text" style="white-space: pre-wrap;" t-out="q.question"/>
                                <t t-if="q.qtype == 'single'">
                                    <div class="form-check" t-foreach="[['A', q.option_a], ['B', q.option_b], ['C', q.option_c], ['D', q.option_d]]" t-as="opt">
                                        <input class="form-check-input" type="radio"
                                               t-att-name="'q_' + str(q.id)"
                                               t-att-id="'q_' + str(q.id) + '_' + opt[0]"
                                               t-att-value="opt[0]"/>
                                        <label class="form-check-label" t-att-for="'q_' + str(q.id) + '_' + opt[0]">
                                            <b t-out="opt[0]"/>. <t t-if="opt[1]" t-out="opt[1]"/>
                                        </label>
                                    </div>
                                </t>
                                <t t-elif="q.qtype == 'multi'">
                                    <div class="form-check" t-foreach="[['A', q.option_a], ['B', q.option_b], ['C', q.option_c], ['D', q.option_d]]" t-as="opt">
                                        <input class="form-check-input" type="checkbox"
                                               t-att-name="'q_' + str(q.id)"
                                               t-att-id="'q_' + str(q.id) + '_' + opt[0]"
                                               t-att-value="opt[0]"/>
                                        <label class="form-check-label" t-att-for="'q_' + str(q.id) + '_' + opt[0]">
                                            <b t-out="opt[0]"/>. <t t-if="opt[1]" t-out="opt[1]"/>
                                        </label>
                                    </div>
                                </t>
                                <t t-else="">
                                    <input type="text" class="form-control w-75"
                                           t-att-name="'q_' + str(q.id)"/>
                                </t>
                            </div>
                        </div>
                    </t>
                    <button type="submit" class="btn btn-primary btn-lg">提交答卷</button>
                </form>
            </div>
        </t>
    </template>

    <!-- ============ 结果页 ============ -->
    <template id="edu_quiz_result" name="Edu Quiz Result">
        <!-- 同上（门户壳提供两外层）。⚠ 本页原 container 也带 style="max-width: 700px;"
             （任务书只点名了答题页的 900px，这是**第二处**限宽）—— 一并保留，挪到内层 div，
             否则 1440 下结果卡会被拉成整幅宽。 -->
        <t t-call="edu_portal.edu_page">
            <div class="mx-auto" style="max-width: 700px;">
                <div class="text-center card border-0 shadow-sm rounded-4 p-5">
                    <h1 class="display-4 fw-bold text-primary" t-out="attempt.pct_str"/>
                    <p class="fs-5">得分 <b t-out="attempt.score"/></p>
                    <p class="opacity-75">测验：<t t-out="attempt.quiz_id.name"/></p>
                    <div class="mt-3">
                        <a href="/quiz" class="btn btn-outline-primary me-2">返回测验列表</a>
                        <a href="/my/home" class="btn btn-light">回首页</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- 3d：我的测验成绩（逐次记录） -->
    <template id="edu_quiz_my" name="Edu Quiz My Results">
        <!-- 同上：门户壳已提供 #wrap.o_portal_wrap + container.b11-content，不再自套两层。 -->
        <t t-call="edu_portal.edu_page">
            <!-- 2026-10-03：本页标题原先只挂了 `oe-cat-title` 这个**类名**，却不在 `.oe-cat-head` 里。
                 而本仓**全部** `.oe-cat-title` 样式都作用域在
                 `#wrapwrap.o_portal .o_portal_wrap .oe-cat-head .oe-cat-title`（custom_home.css:14/325）
                 ⇒ 类名等于没生效：实测 1440 下 **40px/500**，而兄弟页 /quiz 是 **20px/600**（同一视觉元素差一倍）。
                 改成与 /quiz 同构的 `.oe-cat-head`（圆点 + 标题 + 右侧按钮用 ms-auto 顶到右边）。 -->
            <div class="oe-cat-head mb-3">
                <span class="oe-cat-dot"></span>
                <h2 class="oe-cat-title mb-0">我的测验成绩</h2>
                <a href="/quiz" class="btn btn-sm btn-outline-secondary ms-auto">
                    <i class="fa fa-arrow-left me-1"/>返回测验列表</a>
            </div>
            <t t-if="not rows">
                <div class="oe-norec mt-3">
                    <i class="fa fa-question-circle oe-norec-ic" aria-hidden="true"></i>
                    <p class="oe-norec-txt">还没有参加过测验，去
                        <a href="/quiz">测验列表</a> 挑一个开始吧。</p>
                </div>
            </t>
            <t t-else="">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>测验</th>
                                    <th>得分</th>
                                    <th class="text-end">正确率</th>
                                    <th class="text-end d-none d-md-table-cell">时间</th>
                                    <th class="text-end">详情</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rows" t-as="r">
                                    <tr>
                                        <td class="fw-semibold" t-out="r['quiz_name']"/>
                                        <td t-out="r['score_str']"/>
                                        <td class="text-end">
                                            <span t-att-class="'badge ' + (r['pct'] >= 60 and 'text-bg-success' or 'text-bg-danger')"
                                                  t-out="str(r['pct']) + '%'"/>
                                        </td>
                                        <td class="text-end text-muted small d-none d-md-table-cell"
                                            t-out="r['date']"/>
                                        <td class="text-end">
                                            <a t-att-href="r['href']" class="btn btn-sm btn-light">查看</a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
