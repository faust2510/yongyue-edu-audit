<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 列表视图（对齐原站：Name / Category / Company 列风格） -->
    <record id="view_edu_quiz_list" model="ir.ui.view">
        <field name="name">edu.quiz.list</field>
        <field name="model">edu.quiz</field>
        <field name="arch" type="xml">
            <list string="Quizzes">
                <field name="name"/>
                <field name="category"/>
                <field name="course_id"/>
                <field name="total_points" sum="Total"/>
                <field name="duration" widget="float_time" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <!-- 表单视图 -->
    <record id="view_edu_quiz_form" model="ir.ui.view">
        <field name="name">edu.quiz.form</field>
        <field name="model">edu.quiz</field>
        <field name="arch" type="xml">
            <form string="Quiz">
                <header>
                    <button name="action_publish" type="object" string="发布"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="关闭"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="测验名称"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="course_id"/>
                            <field name="duration"/>
                        </group>
                        <group>
                            <field name="total_points"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="题目">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question"/>
                                    <field name="qtype"/>
                                    <field name="option_a"/>
                                    <field name="option_b"/>
                                    <field name="answer"/>
                                    <field name="points" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 作答记录 -->
    <record id="view_edu_quiz_attempt_list" model="ir.ui.view">
        <field name="name">edu.quiz.attempt.list</field>
        <field name="model">edu.quiz.attempt</field>
        <field name="arch" type="xml">
            <list string="Attempts">
                <field name="quiz_id"/>
                <field name="student_id"/>
                <field name="score"/>
                <field name="total"/>
                <field name="pct_str"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- 动作与菜单 -->
    <record id="action_edu_quiz" model="ir.actions.act_window">
        <field name="name">Quiz</field>
        <field name="res_model">edu.quiz</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_edu_quiz_attempt" model="ir.actions.act_window">
        <field name="name">Quiz Attempts</field>
        <field name="res_model">edu.quiz.attempt</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_edu_quiz_root" name="测验"
              web_icon="edu_quiz,static/description/icon.png"
              sequence="42"/>
    <menuitem id="menu_edu_quiz" name="Quizzes"
              parent="menu_edu_quiz_root" action="action_edu_quiz"/>
    <menuitem id="menu_edu_quiz_attempts" name="Attempts"
              parent="menu_edu_quiz_root" action="action_edu_quiz_attempt"/>
</odoo>
