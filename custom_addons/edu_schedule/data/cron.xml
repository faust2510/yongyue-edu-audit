<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v3 课前提醒：每 5 分钟扫描 T-30min 未提醒的在线课节。
         形态抄 Moodle mod_zoom 的独立计划任务 send_ical_notifications；
         幂等由 op.session.reminder_sent_at 保证。
         依据：docs/research/onestop-learning-and-repetitive-work.md §2 / §5#4 -->
    <record id="ir_cron_edu_session_reminder" model="ir.cron">
        <field name="name">edu_schedule: 课节课前提醒（每 5 分钟）</field>
        <field name="model_id" ref="model_op_session"/>
        <field name="state">code</field>
        <field name="code">model.cron_session_reminder()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
