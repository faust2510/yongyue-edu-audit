<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         网站侧权限组：班务机器人管理员（2026-10-13，校长要求给教务 Sarah 开行政账号）

         背景：本模块的 11 张表原先只给 base.group_system（= 超级管理员/设置），
         于是「用网站后台管机器人」这件事只有超管能干，教务进不去（点菜单就 AccessError）。

         这里新增一个**业务级**权限组，与「设置/技术」分开：
           · 教务（行政级账号）勾上本组即可登录网站后台管理机器人
             —— 群与短名、人员映射、文案模板、定时提醒、打卡统计、
                按钮回填、材料归档（含下载文件）、发送记录；
           · 超管天然照旧（ir.model.access.csv 里 base.group_system 的行一条没动）；
           · 本组**不隐含** base.group_system：它是教务权限，不是系统管理员。
         分配办法：设置 → 用户 → 勾「其它」下的「班务机器人管理员」
         （或由 scripts 直接把用户加进本组）。
         ============================================================ -->
    <record id="group_assist_manager" model="res.groups">
        <field name="name">班务机器人管理员</field>
        <field name="comment">用网站后台管理 Telegram 班务机器人：群与短名、人员映射、文案模板、定时提醒、打卡统计、按钮回填、材料归档（可下载老师转发的文件）、发送记录。不包含系统设置权限。</field>
    </record>
</odoo>
